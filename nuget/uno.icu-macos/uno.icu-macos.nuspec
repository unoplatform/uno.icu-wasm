<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata minClientVersion="5.0.0">
        <id>Uno.icu-macos</id>
        <version>0.0.1</version>
        <title>Uno ICU for MacOS</title>
        <authors>Uno Platform</authors>
        <owners>unoplatform</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="file">LICENSE.txt</license>
        <readme>NOTICE.md</readme>
        <projectUrl>https://github.com/unoplatform/uno.icu</projectUrl>
        <description>The International Components for Unicode for macOS</description>
        <copyright>Copyright (C) 2015-2025 Uno Platform inc. - all rights reserved</copyright>
        <repository type="git" url="https://github.com/unoplatform/uno.icu.git" commit="$RepositoryCommit$" />
    </metadata>
    <files>
        <file src="..\provenance\LICENSE.txt" target="" />
        <file src="..\provenance\NOTICE.md" target="" />
        <file src="..\provenance\ICU-LICENSE.txt" target="licenses" />
        <file src="..\provenance\Uno-LICENSE.md" target="licenses" />
        <file src="..\provenance\source.json" target="provenance" />
        <file src="..\provenance\Uno.icu-macos.payloads.json" target="provenance" />
        <file src="buildTransitive\Uno.icu-macos.targets" target="buildTransitive" />
        <file src="..\Uno.icu.Common.targets" target="buildTransitive" />
        <file src="..\icudt.dat" target="buildTransitive" />
        <file src="libicu/libicuuc.dylib" target="runtimes/osx/native" />
        <file src="libicu/libicudata.dylib" target="runtimes/osx/native" />
    </files>
</package>